# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Environment
.env
.venv/
venv/
env/

# IDE / OS
.DS_Store
Thumbs.db
*.swp
*.swo

# Local / personal (do not commit)
*.local
secrets*
*_secret*
code/local_ibm_env.ps1

# Large raw data (obtain from Dryad CC0 or local mirror)
readout_raw_data/

# IBM raw shot dumps (regenerate with collect_ibm_shots.py)
results/ibm_raw_shots/

# Run logs
results/**/*.log

# Console noise from long Fisher jobs
results/fisher_stdout*.txt
results/fisher_stderr*.txt

# Exploratory IBM subset analyses (10–20q, no-5q, raw4 ablations)
results/ibm_marrakesh_10_20_*
results/ibm_torino_10_20_*
results/ibm_marrakesh_no5q_*
results/ibm_torino_no5q_*
results/ibm_marrakesh_raw4_*
results/ibm_torino_raw4_*

# Large binary caches: ignore only if you place multi-GB exports here.
# Small transition-matrix bundles (Sycamore / LLM) are tracked for reproducibility.

# Optional KL exploration console dumps
results/grammar_pairwise_kl_*.txt

# Extra Fisher diagnostic plots (publication figures: results/fisher_figures/)
results/fisher_phase_transition_all_readouts*.png
results/fisher_phase_transition_summary.png

# LaTeX build artifacts (preprint in docs/ or stray builds under results/)
docs/*.aux
results/*.aux
results/*.out
docs/*.out
docs/*.log
docs/*.toc
docs/*.synctex.gz
docs/*.fdb_latexmk
docs/*.fls
